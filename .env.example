# Configuración de base de datos
# Copiar este archivo como .env y completar los valores según tu entorno local

# Puerto del servidor Express
PORT=3002

# Host de la base de datos
DB_HOST=localhost

# Puerto de la base de datos (3306 para MySQL)
DB_PORT=3306

# Usuario de la base de datos
DB_USER=app_user

# Contraseña del usuario de la base de datos (entre comillas si tiene caracteres especiales)
DB_PASSWORD="#ADSO_node"

# Nombre de la base de datos
DB_NAME=gestion_tareas
