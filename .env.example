# Configuración de base de datos
# npm install copia este archivo como .env automáticamente (si no existe)
# Completar los valores según tu entorno local

# Puerto del servidor Express
PORT=3002

# Host de la base de datos
DB_HOST=localhost

# Puerto de la base de datos (3306 para MySQL)
DB_PORT=3306

# Usuario de la base de datos (lo crea npm run db:init)
DB_USER=grupo4

# Contraseña del usuario de la base de datos (entre comillas si tiene caracteres especiales)
DB_PASSWORD="grupo4"

# Nombre de la base de datos
DB_NAME=gestion_tareas

# Credenciales admin de MySQL (opcionales, para npm run db:init)
# Si no se definen, db:init las pide por consola
# DB_ADMIN_USER=root
# DB_ADMIN_PASSWORD=tu_password_admin
